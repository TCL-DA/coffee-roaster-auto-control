@@ -0,0 +1,113 @@
+#pragma once
+// ============================================================================
+// CHẾ ĐỘ VẬN HÀNH — ẩn thông số mẻ, nhân viên chỉ thấy tiến độ + lỗi gọn E1..E9
+// Kế hoạch: docs/plan/2026-09-11-che-do-van-hanh-an-thong-so.md (Rev 2 — 08/10/2026)
+//
+// LÁT 1 (08/10/2026, chờ chủ máy duyệt): CHỈ hàm tính THUẦN — không đọc/ghi biến toàn cục, không Modbus, không SD,
+// CHƯA được gọi từ loop() / programScan(). Nạp bản này không đổi hành vi máy. Test trên PC: tools/op_mode_test/chay.py.
+// Lát sau mới móc vào luồng: ghi W40126..129, đọc $M62..65, chốt rang lố, ẩn số, oplog.csv.
+//
+// Cần STP_* (Define.h) có trước khi include file này.
+// ============================================================================
+#include <stdint.h>
+
+// ---- Mã giai đoạn ghi lên OP_PHASE_W (HMI đổi ra chữ bằng Text Table) — kế hoạch §3
+enum OpPhase : uint8_t {
+    OP_NGHI = 0,          // Nghỉ
+    OP_CHUAN_BI = 1,      // Đang sấy lồng / lên nhiệt chờ nạp (preheat, STP_DATA, STP_COOL_DOWN, STP_GAS)
+    OP_CHO_NAP = 2,       // Chờ nạp hạt (nạp tay)
+    OP_DANG_NAP = 3,      // Đang nạp hạt (bộ nạp tự động chạy)
+    OP_SAY_HAT = 4,       // STP_TP
+    OP_CHUYEN_VANG = 5,   // STP_YELLOW
+    OP_SAP_NO = 6,        // STP_FCS
+    OP_PHAT_TRIEN = 7,    // STP_DEV
+    OP_XA_NGUOI = 8,      // STP_DROP / STP_COOLING / STP_ESCAPE / bồn nguội chạy
+    OP_XONG_ME = 9        // STP_LOOP_1 / STP_LOOP_2 — chờ mẻ kế
+};
+
+// Ảnh chụp trạng thái máy — lát sau lấy từ START_BTN_R, wuState, aLoaderStep, coolStep, progStep
+struct OpVao {
+    bool    startOn;      // START_BTN_R == 1
+    bool    preheat;      // wuState != WU_IDLE
+    bool    loaderBusy;   // aLoaderStep đang chạy (nạp tự động)
+    bool    cooling;      // coolStep != 0
+    uint8_t progStep;
+};
+
+inline uint8_t opPhase(const OpVao &v) {
+    switch (v.progStep) {
+        case STP_DROP: case STP_COOLING: case STP_ESCAPE:   return OP_XA_NGUOI;
+        case STP_LOOP_1: case STP_LOOP_2:                   return OP_XONG_ME;
+        case STP_TP:                                        return OP_SAY_HAT;
+        case STP_YELLOW:                                    return OP_CHUYEN_VANG;
+        case STP_FCS:                                       return OP_SAP_NO;
+        case STP_DEV:                                       return OP_PHAT_TRIEN;
+        default: break;
+    }
+    if (v.cooling) return OP_XA_NGUOI;                    // bồn nguội còn chạy sau khi mẻ đã về 0
+    if (v.startOn && (v.progStep == STP_CHECK || v.progStep == STP_CHARGE))
+        return v.loaderBusy ? OP_DANG_NAP : OP_CHO_NAP;
+    if (v.preheat || v.startOn) return OP_CHUAN_BI;       // STP_DATA / STP_COOL_DOWN / STP_GAS hoặc sấy lồng riêng
+    return OP_NGHI;
+}
+
+// ---- Tiến độ % và giây còn lại — kế hoạch §3: không bao giờ lùi, neo theo mốc thật, mẻ lê quá giờ thì "sắp xong"
+// mocPct: % thời gian của mốc vừa đạt trong hồ sơ mẫu (0 = chưa có mốc nào / không biết)
+inline uint8_t opProgress(uint16_t tRoast, uint16_t tDropMau, uint8_t daXa, uint8_t pctTruoc, uint8_t mocPct) {
+    if (daXa) return 100;
+    uint32_t p = (tDropMau > 0) ? (uint32_t)tRoast * 100u / tDropMau : 0;
+    if (p < mocPct) p = mocPct;                           // đạt DE / FCs sớm hơn mẫu: kéo lên bằng % mốc đó
+    if (p > 99) p = 99;                                   // chưa xả thật thì không báo 100
+    if (p < pctTruoc) p = pctTruoc;                       // không bao giờ lùi
+    return (uint8_t)p;
+}
+
+inline uint16_t opRemain(uint16_t tRoast, uint16_t tDropMau) {
+    return (tDropMau > tRoast) ? (uint16_t)(tDropMau - tRoast) : 0;   // 0 = "sắp xong", không hiện số âm
+}
+
+// ---- 9 mã lỗi gọn cho nhân viên — kế hoạch §4. 0 = không phải lỗi cho nhân viên.
+// Mã 422 (rang lố, đã xả) là mã MỚI của chế độ này: lát sau thêm STT_ERR_OVER_ROAST 422 + dòng chữ HMI.
+inline uint8_t opAlarmFromStt(uint16_t stt) {
+    switch (stt) {
+        case 401: case 413: case 263: case 264:            return 1;   // QUÁ NHIỆT — đã tắt lửa, GIỮ hạt
+        case 410: case 414: case 403: case 164:            return 2;   // LỬA KHÔNG LÊN
+        case 404: case 405: case 265: case 266: case 271:  return 3;   // HỎNG CẢM BIẾN NHIỆT — XẢ hạt
+        case 406: case 407: case 408:                      return 4;   // MẤT KẾT NỐI THIẾT BỊ
+        case 422:                                          return 5;   // RANG LỐ — đã xả
+        case 421: case 327:                                return 6;   // MẺ LÊ, KHÔNG LÊN NHIỆT
+        case 417:                                          return 7;   // CỬA XẢ KHÔNG ĐÓNG
+        case 103: case 120: case 409:                      return 8;   // LỖI HỒ SƠ / THẺ NHỚ
+        case 416:                                          return 9;   // MẺ ĐANG DÀI HƠN MẪU
+        default: break;
+    }
+    if (stt >= 281 && stt <= 287) return 4;                // mất Modbus HMI / BT / ET / trống / gió / relay / áp hút
+    if (stt >= 381 && stt <= 385) return 8;                // hồ sơ thiếu mốc / sai định dạng
+    return 0;
+}
+
+// Mức: 3 = đỏ (dừng máy), 2 = cam (máy tự xử lý rồi báo), 1 = vàng (theo dõi), 0 = không lỗi
+inline uint8_t opMucE(uint8_t e) {
+    if (e == 0) return 0;
+    if (e == 5 || e == 6) return 2;
+    if (e == 9) return 1;
+    return 3;
+}
+
+// Giữ mã NẶNG NHẤT đang hiệu lực: mức cao hơn thắng; cùng mức thì E nhỏ hơn (theo thứ tự bảng §4) thắng
+inline uint8_t opNangHon(uint8_t a, uint8_t b) {
+    if (opMucE(a) != opMucE(b)) return opMucE(a) > opMucE(b) ? a : b;
+    if (a == 0) return b;
+    if (b == 0) return a;
+    return a < b ? a : b;
+}
+
+// Lỗi đỏ chỉ xoá được khi điều kiện đã hết; cam / vàng xoá ngay khi bấm Xoá lỗi ($M18 = 1) — kế hoạch §4
+inline bool opXoaDuoc(uint8_t e, bool dieuKienConHieuLuc) {
+    return opMucE(e) < 3 || !dieuKienConHieuLuc;
+}
+
+// Quá nhiệt (E1) thì GIỮ hạt (mở cửa lúc cháy = thêm oxy); máy mù / mất kết nối (E3, E4) thì XẢ hạt — chốt #3
+inline bool opCanXaHat(uint8_t e) {
+    return e == 3 || e == 4;
+}
