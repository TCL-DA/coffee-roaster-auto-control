+// Test trên PC cho include/OperatorMode.h (chế độ vận hành, lát 1). Chạy: python tools/op_mode_test/chay.py
+#include <cstdio>
+#include "stp_tu_define.h"      // chay.py trích STP_* từ include/Define.h — không chép tay
+#include "../../include/OperatorMode.h"
+
+static int dat = 0, loi = 0;
+#define KIEM(dk, ten) do { if (dk) dat++; else { loi++; printf("LOI %s (dong %d)\n", ten, __LINE__); } } while (0)
+
+int main() {
+    // giai đoạn
+    KIEM(opPhase({false, false, false, false, STP_DATA}) == OP_NGHI, "rảnh = Nghỉ");
+    KIEM(opPhase({false, true, false, false, STP_DATA}) == OP_CHUAN_BI, "sấy lồng riêng = Chuẩn bị");
+    KIEM(opPhase({true, false, false, false, STP_GAS}) == OP_CHUAN_BI, "STP_GAS = Chuẩn bị");
+    KIEM(opPhase({true, false, false, false, STP_CHARGE}) == OP_CHO_NAP, "nạp tay = Chờ nạp");
+    KIEM(opPhase({true, false, true, false, STP_CHECK}) == OP_DANG_NAP, "bộ nạp chạy = Đang nạp");
+    KIEM(opPhase({true, false, false, false, STP_TP}) == OP_SAY_HAT, "TP");
+    KIEM(opPhase({true, false, false, false, STP_YELLOW}) == OP_CHUYEN_VANG, "Yellow");
+    KIEM(opPhase({true, false, false, false, STP_FCS}) == OP_SAP_NO, "FCs");
+    KIEM(opPhase({true, false, false, false, STP_DEV}) == OP_PHAT_TRIEN, "DEV");
+    KIEM(opPhase({true, false, false, false, STP_ESCAPE}) == OP_XA_NGUOI, "Escape");
+    KIEM(opPhase({false, false, false, true, STP_DATA}) == OP_XA_NGUOI, "bồn nguội còn chạy sau mẻ");
+    KIEM(opPhase({true, false, false, false, STP_LOOP_2}) == OP_XONG_ME, "chờ mẻ kế");
+    // tiến độ
+    KIEM(opProgress(300, 600, 0, 0, 0) == 50, "nửa mẻ = 50 %");
+    KIEM(opProgress(700, 600, 0, 0, 0) == 99, "quá giờ mẫu, chưa xả = 99, không 100");
+    KIEM(opProgress(700, 600, 1, 99, 0) == 100, "đã xả = 100");
+    KIEM(opProgress(100, 600, 0, 40, 0) == 40, "không bao giờ lùi");
+    KIEM(opProgress(200, 600, 0, 0, 80) == 80, "neo theo mốc thật (FCs sớm)");
+    KIEM(opProgress(200, 0, 0, 0, 0) == 0, "chưa có hồ sơ mẫu -> 0, không chia 0");
+    KIEM(opRemain(700, 600) == 0 && opRemain(100, 600) == 500, "còn lại không âm");
+    // lỗi gọn
+    KIEM(opAlarmFromStt(413) == 1 && opAlarmFromStt(263) == 1, "báo cháy = E1");
+    KIEM(opAlarmFromStt(414) == 2, "chờ lửa quá lâu = E2");
+    KIEM(opAlarmFromStt(271) == 3, "cảm biến BT = E3");
+    KIEM(opAlarmFromStt(284) == 4 && opAlarmFromStt(281) == 4 && opAlarmFromStt(287) == 4, "mất Modbus = E4");
+    KIEM(opAlarmFromStt(288) == 0, "lỗi CRC lẻ (288) không bắn E4");
+    KIEM(opAlarmFromStt(422) == 5, "rang lố = E5");
+    KIEM(opAlarmFromStt(417) == 7 && opAlarmFromStt(383) == 8 && opAlarmFromStt(416) == 9, "E7 E8 E9");
+    KIEM(opAlarmFromStt(1) == 0 && opAlarmFromStt(59) == 0, "trạng thái thường = 0");
+    KIEM(opMucE(1) == 3 && opMucE(5) == 2 && opMucE(9) == 1 && opMucE(0) == 0, "mức");
+    KIEM(opNangHon(9, 4) == 4 && opNangHon(5, 9) == 5 && opNangHon(3, 1) == 1 && opNangHon(0, 6) == 6, "giữ mã nặng nhất");
+    KIEM(!opXoaDuoc(1, true) && opXoaDuoc(1, false) && opXoaDuoc(5, true), "đỏ chỉ xoá khi hết điều kiện");
+    KIEM(!opCanXaHat(1) && opCanXaHat(3) && opCanXaHat(4), "quá nhiệt GIỮ hạt, máy mù XẢ hạt");
+    printf("KET QUA op_mode: %d/%d dat\n", dat, dat + loi);
+    return loi ? 1 : 0;
+}
