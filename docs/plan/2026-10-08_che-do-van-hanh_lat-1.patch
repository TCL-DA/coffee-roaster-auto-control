+# -*- coding: utf-8 -*-
+"""Biên dịch + chạy test_op_mode.cpp (zig c++, như tools/fw_sim). STP_* trích thẳng từ include/Define.h.
+    python tools/op_mode_test/chay.py"""
+import os
+import re
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(os.path.dirname(HERE))
+d = open(os.path.join(REPO, 'include', 'Define.h'), encoding='utf-8', errors='replace').read()
+stp = re.findall(r'^#define (STP_[A-Z0-9_]+)\s+(\d+)', d, re.M)
+open(os.path.join(HERE, 'stp_tu_define.h'), 'w', encoding='utf-8').write(
+    '#pragma once\n// SINH TỰ ĐỘNG từ include/Define.h bởi chay.py — không sửa tay\n' +
+    ''.join('#define %s %s\n' % kv for kv in stp))
+exe = os.path.join(HERE, 'test_op_mode.exe')
+r = subprocess.run([sys.executable, '-m', 'ziglang', 'c++', '-std=gnu++17', os.path.join(HERE, 'test_op_mode.cpp'), '-o', exe],
+                   capture_output=True, text=True)
+if r.returncode:
+    sys.exit('biên dịch lỗi:\n' + r.stderr[-2000:])
+sys.exit(subprocess.run([exe]).returncode)
